#include <windows.h>
#include "version.h"
1 ICON "../installer-exe/app.ico"
1 RT_MANIFEST "report.manifest"
VS_VERSION_INFO VERSIONINFO
 FILEVERSION MA2_VER_COMMA
 PRODUCTVERSION MA2_VER_COMMA
 FILEFLAGSMASK 0x3fL
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "MechAssault 2 Report a problem"
      VALUE "ProductName", "MechAssault 2 PC Recomp (unofficial)"
      VALUE "FileVersion", MA2_VER_FILE
      VALUE "ProductVersion", MA2_VER_STR
      VALUE "OriginalFilename", "MA2 Report.exe"
      VALUE "Comments", "Unofficial fan project. Sends a problem report (logs, settings and PC details, with names and personal folders removed) only when the player clicks Send."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
